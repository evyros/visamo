# Public marketing site URL (used for canonical URLs, hreflang and the sitemap)
NEXT_PUBLIC_SITE_URL=https://visamo.co.il

# The app that "Start free" / "Log in" point to (/signup, /login)
NEXT_PUBLIC_APP_URL=https://app.visamo.co.il

# WhatsApp Business number, international format, digits only (e.g. 972501234567).
# When empty, WhatsApp links fall back to the support email.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Basin form ID for the contact form (usebasin.com → your form → the ID in https://usebasin.com/f/<ID>)
NEXT_PUBLIC_BASIN_FORM_ID=
