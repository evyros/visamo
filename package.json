{
  "name": "visamo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs --local",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "catalog:lock": "UPDATE_CATALOG_LOCK=1 vitest run lib/documents/catalog.test.ts",
    "prompts:lock": "UPDATE_PROMPTS_LOCK=1 vitest run lib/prompts.test.ts",
    "guides:sync": "SYNC_GUIDES=1 vitest run lib/knowledge-base.test.ts",
    "eval:checks": "vitest run --config vitest.evals.config.mts evals/checks"
  },
  "dependencies": {
    "@freemius/checkout": "^1.5.1",
    "@freemius/sdk": "^0.5.0",
    "@fullstory/browser": "^2.1.2",
    "@hyzyla/pdfium": "^2.1.13",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
