# Public marketing site URL (used for canonical URLs, hreflang and the sitemap)
NEXT_PUBLIC_SITE_URL=https://visamo.co.il

# The app that "Start free" / "Log in" point to (/signup, /login)
NEXT_PUBLIC_APP_URL=https://app.visamo.co.il

# Cloudflare Turnstile, the bot check on the contact form (dash.cloudflare.com → Turnstile).
# For local development, Cloudflare's test keys always pass:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── App & sign-in ────────────────────────────────────────────────────────────
# Local development URLs are in .env.development (committed, next dev only):
# the app on http://localhost:3000, the website on http://site.localhost:3000.
# The app gets plain localhost because Google OAuth rejects app.localhost.

# Neon Postgres connection string (Neon console → your project → Connect).
# Use the pooled connection string.
DATABASE_URL=

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorized redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key (resend.com → API Keys) and a sender on a verified domain.
# When RESEND_API_KEY is empty, sign-up and reset links are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM=Visamo <no-reply@visamo.co.il>

# ── Admin panel ──────────────────────────────────────────────────────────────
# The admin panel's host (app/admin). The login page asks for an email and an
# OTP from an authenticator app. Only when both match does it email
# ADMIN_EMAIL a link, and the link sets a signed cookie on this host alone.
# ADMIN_TOTP_SECRET is the authenticator app's secret, in base32. Create it,
# and the key to add to the app, with: node scripts/admin-totp.mjs
# ADMIN_SECRET signs the link and the cookie; changing it signs the admin out
# everywhere. Generate with: openssl rand -base64 32
NEXT_PUBLIC_ADMIN_URL=https://admin.visamo.co.il
ADMIN_EMAIL=
ADMIN_TOTP_SECRET=
ADMIN_SECRET=

# ── Uploaded documents ───────────────────────────────────────────────────────
# A PRIVATE Vercel Blob store (Vercel → Storage → Create → Blob → access
# Private), connected to the project with the Development environment
# included. `vercel env pull` then writes these to .env.local. The static
# token is needed to give browsers upload tokens (app/api/files/upload).
# Use a separate store for development and production.
BLOB_READ_WRITE_TOKEN=

# ── Chat assistant ───────────────────────────────────────────────────────────
# OpenRouter API key (openrouter.ai → Keys). The assistant runs on Claude
# Haiku; OPENROUTER_MODEL can point it at another OpenRouter model id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# The document checker runs on Claude Haiku, only through providers with zero
# data retention; OPENROUTER_CHECK_MODEL can point it at another model id that
# reads PDFs and images and supports structured outputs.
OPENROUTER_CHECK_MODEL=

# ── Purchases ────────────────────────────────────────────────────────────────
# Freemius sells the one-time purchases, in a checkout overlay over the app.
# Freemius → your product → Settings → API & Keys: the product id and keys.
# The product has a lifetime plan, priced in ILS, for each purchase: their
# numeric ids (not their names) are in Freemius → your product → Plans.
# Webhook: Freemius → your product → Integrations → Webhooks, URL
#   <NEXT_PUBLIC_APP_URL>/api/freemius/webhook, with the events license.created,
#   payment.refund, payment.dispute.lost and payment.dispute.closed.
# FREEMIUS_SANDBOX=1 makes the checkout take Freemius's test cards: set it
# everywhere but production. When FREEMIUS_PRODUCT_ID is empty, the buy
# buttons say purchases aren't available.
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_PLAN_MESSAGE_PACK=
FREEMIUS_PLAN_FILE_CHECK=
FREEMIUS_SANDBOX=
