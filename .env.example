# Public marketing site URL (used for canonical URLs, hreflang and the sitemap)
NEXT_PUBLIC_SITE_URL=https://visamo.co.il

# The app that "Start free" / "Log in" point to (/signup, /login)
NEXT_PUBLIC_APP_URL=https://app.visamo.co.il

# WhatsApp Business number, international format, digits only (e.g. 972501234567).
# When empty, WhatsApp links fall back to the support email.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Basin form ID for the contact form (usebasin.com → your form → the ID in https://usebasin.com/f/<ID>)
NEXT_PUBLIC_BASIN_FORM_ID=

# ── App & sign-in ────────────────────────────────────────────────────────────
# Local development URLs are in .env.development (committed, next dev only):
# the app on http://localhost:3000, the website on http://site.localhost:3000.
# The app gets plain localhost because Google OAuth rejects app.localhost.

# Neon Postgres connection string (Neon console → your project → Connect).
# Use the pooled connection string.
DATABASE_URL=

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorized redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key (resend.com → API Keys) and a sender on a verified domain.
# When RESEND_API_KEY is empty, sign-up and reset links are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM=Visamo <no-reply@visamo.co.il>

# ── Uploaded documents ───────────────────────────────────────────────────────
# A PRIVATE Vercel Blob store (Vercel → Storage → Create → Blob → access
# Private), connected to the project with the Development environment
# included. `vercel env pull` then writes these to .env.local. The static
# token is needed to give browsers upload tokens (app/api/files/upload).
# Use a separate store for development and production.
BLOB_READ_WRITE_TOKEN=

# ── Chat assistant ───────────────────────────────────────────────────────────
# OpenRouter API key (openrouter.ai → Keys). The assistant runs on Claude
# Haiku; OPENROUTER_MODEL can point it at another OpenRouter model id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# The document checker runs on Claude Haiku, only through providers with zero
# data retention; OPENROUTER_CHECK_MODEL can point it at another model id that
# reads PDFs and images and supports structured outputs.
OPENROUTER_CHECK_MODEL=
